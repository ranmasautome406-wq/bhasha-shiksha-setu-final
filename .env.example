# =========================================================
# Bhasha Shiksha Setu — environment configuration
# Copy this file to .env  and  fill in your own values:
#     cp .env.example .env
# NEVER commit .env to git. Never share API keys.
# =========================================================

# ---------- Core ----------
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=false

# ---------- Database ----------
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///bhasha_shiksha_setu.db
# PostgreSQL (production, e.g. Render):
# DATABASE_URL=postgresql://user:password@host:5432/bhasha_shiksha_setu

# ---------- AI / Translation (optional) ----------
# demo = built-in offline engine (no key needed)
# openai = use an OpenAI-compatible LLM API (set key + model below)
AI_PROVIDER=demo
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1

# Translation provider: demo | google | openai
TRANSLATION_PROVIDER=demo

# Voice: browser (free, built-in) | external (requires TTS_URL/STT_URL)
TTS_PROVIDER=browser
TTS_URL=
TTS_API_KEY=
STT_URL=
STT_API_KEY=

# ---------- Web ----------
# Comma-separated list of allowed origins, or * for all (dev only)
CORS_ORIGINS=*

# ---------- Auth ----------
TOKEN_EXPIRY_HOURS=24

# ---------- Uploads ----------
MAX_UPLOAD_MB=50

# ---------- First admin (used by seed on first run + create_admin.py) ----------
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@bhasha.setu
ADMIN_PASSWORD=Admin@123

# ---------- Demo data ----------
# Set to false in production to skip sample users/lessons
SEED_DEMO=true

# ---------- Hosting ----------
PORT=5000

# Video dubbing (optional but required for uploaded-video dubbing)
# STT_URL should accept JSON: {"audio":"<base64>","language":"English"} and return {"text":"..."}
# TTS_URL should accept JSON: {"text":"...","language":"Marathi"} and return raw audio bytes.
STT_URL=
STT_API_KEY=
TTS_URL=
TTS_API_KEY=
# Video uploads default to 200 MB; reduce if your hosting plan has a smaller limit.
MAX_UPLOAD_MB=200
